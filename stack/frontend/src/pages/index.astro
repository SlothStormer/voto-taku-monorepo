---
import VideoBG from "../components/VideoBG.astro";
import Layout from "../layouts/Layout.astro";
import topOpenings from "../data/ops.json";

const cards = [
  {
    title: "Openings",
    description: "Vota por el mejor opening",
    href: "/openings",
    img: "yoasobi-oshi-no-ko-theme-song.jpg",
    hoverImgGif: "yoasobi-oshi-no-ko-theme-song.gif",
  },
  {
    title: "Endings",
    description: "Vota por el mejor ending",
    href: "/endings",
    img: "fireforce-veil.jpg",
    hoverImgGif: "fireforce-veil.gif",
  },
];
---

<Layout title="Inicio">
  <VideoBG />
  <div class="text-center mb-8">
    <h1 class="text-5xl md:text-6xl text-white p-2">
      Bienvenido a Voto-Taku
    </h1>
  </div>

  <div class="grid md:grid-cols-2 gap-8 mb-8">
    <div class="bg-accent-dark/80 border border-accent-light/25 rounded-2xl p-6 h-96 backdrop-blur-lg">
      <h3 class="text-center mb-4 text-accent-light text-xl md:text-2xl">
        Top Openings
      </h3>
      <div class="slider-container overflow-hidden mt-7 h-26 relative">
        <ul id="slider" class="text-white">
          {topOpenings.map((item, index) => (
            <li
              class="slider-item flex justify-between items-center mb-2"
            >
              <span class="font-bold text-sm md:text-base text-violet-400">{index + 1}.</span>
              <span class="font-bold text-sm md:text-base">{item.title}</span>
              <span class="block text-accent-light text-xs md:text-sm">
                {item.grade}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="bg-accent-dark/80 border border-accent-light/25 rounded-2xl p-6 h-96 backdrop-blur-lg">
      <h3 class="text-center mb-4 text-accent-light text-xl md:text-2xl">
        Top Endings
      </h3>
      <h4 class="text-center">Aún no hay ranking de endings...</h4>
    </div>
  </div>

  <div class="flex flex-wrap justify-center gap-8 mb-8 px-4">
    {cards.map((card) => (
      <a
        href={card.href}
        class="w-full h-full mt-8 max-w-sm bg-accent-dark/80 border border-accent-light/25 rounded-3xl text-white hover:-translate-y-1 hover:shadow-lg hover:shadow-accent/30 transition-all backdrop-blur-xl relative overflow-hidden"
       // data-astro-prefetch="load" ¿Para que se usa esto?
      >
        <img
          src={card.img}
          class="rounded-t-2xl w-full h-auto transition-opacity duration-300 hover:opacity-0"
          alt=""
        />
        <img
          src={card.hoverImgGif}
          class="rounded-t-2xl w-full h-auto absolute top-0 left-0 opacity-0 transition-opacity duration-300 hover:opacity-100"
          alt=""
        />
        <div class="px-4 py-2">
          <h2 class="text-2xl md:text-4xl text-accent-light">{card.title}</h2>
          <p class="text-gray-400">{card.description}</p>
        </div>
      </a>
    ))}
  </div>
</Layout>

<style>
@import "../styles/index.css";
</style>
