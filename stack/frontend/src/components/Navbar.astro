---
import { Image } from 'astro:assets';
import logo from "../../public/logo5_40x40.webp";
---

<nav class="bg-[#280d30] px-4 py-2 flex items-center justify-between">
  <div class="flex items-center gap-4 text-white">
    <div class="size-10">
      <Image src={logo || "/placeholder.svg"} alt="VotoTaku Logo" width={40} height={40} />
    </div>
    <h2 class="text-white text-lg font-bold leading-tight tracking-[-0.015em]">VotoTaku</h2>
  </div>
  
  <div class="flex items-center gap-8">
    <div class="hidden md:flex items-center gap-9">
      <a class="text-white text-sm font-medium leading-normal hover:text-[#c77edd] transition-colors" href="#">Openings</a>
      <a class="text-white text-sm font-medium leading-normal hover:text-[#c77edd] transition-colors" href="#">Endings</a>
    </div>
    <div class="flex gap-2">
      <button
        class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-4 bg-[#760299] text-white text-sm font-bold leading-normal tracking-[0.015em] hover:bg-[#8f02b9] transition-colors"
      >
        <span class="truncate">Iniciar Sesión</span>
      </button>
      <button
        class="flex max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 bg-[#4d195d] text-white gap-2 text-sm font-bold leading-normal tracking-[0.015em] min-w-0 px-2.5 hover:bg-[#5d1f70] transition-colors"
        aria-label="Perfil de usuario"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true">
          <path
            d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24ZM74.08,197.5a64,64,0,0,1,107.84,0,87.83,87.83,0,0,1-107.84,0ZM96,120a32,32,0,1,1,32,32A32,32,0,0,1,96,120Zm97.76,66.41a79.66,79.66,0,0,0-36.06-28.75,48,48,0,1,0-59.4,0,79.66,79.66,0,0,0-36.06,28.75,88,88,0,1,1,131.52,0Z"
          ></path>
        </svg>
      </button>
    </div>
  </div>
</nav>